{
  "name": "belentani-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo unificado: UX Academy + Manos Abiertas + Belentani Judas + más",
  "workspaces": ["packages/*"],
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "npm --workspace dashboard run dev",
